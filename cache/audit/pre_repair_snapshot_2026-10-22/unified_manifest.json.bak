    "positional_sources": {
      "candidates": {
        "files": [
          "DATASETS/candidates_1907.04931.json",
          "DATASETS/candidates_2104.01277.json",
          "DATASETS/candidates_2206.00364.json",
          "DATASETS/candidates_2605.22902.json",
          "DATASETS/candidates_2605.27315.json"
        ],
        "fields": {
          "position": "bbox",
          "text": "line_text",
          "classification": "classification"
        }
      },
      "classified_symbols": {
        "file": "DATASETS/classified_symbols_verify.json",
        "fields": {
          "position": "bbox",
          "text": "ocr_text",
          "region_index": "region_index"
        }
      },
      "chroma_discrepancies": {
        "file": "DATASETS/chroma_visual_discrepancies.json",
        "fields": {
          "paper": "paper_id",
          "scan_id": "scan_entry_id"
        }
      }
    },
    "reference_keys": {
      "glyph_name": "name (e.g., 'rma (8x19)', 'sigma', 'delta')",
      "position_text": "line_text in candidates.json / ocr_text in classified_symbols_verify.json"
    },
    "reference_rules": [
      "Match positional 'text' (candidates.json 'line_text' / classified_symbols_verify.json 'ocr_text') against glyph 'alt'/'title' in GIF-and-PNG-Images-for-Math-Symbols.html",
      "Positions carry pixel coordinates in PDF coordinate space (x0,y0 -> x1,y1)",
      "Glyph URLs point to metamath.org symbol images (24 local + 1158 remote)",
      "A positional entry can reference multiple glyphs if the OCR text contains multiple symbols",
      "Relationship is positional: same symbol rendered in different papers maps to different positions but same glyph name"
    ],
    "symbols_zip": {
      "source": "https://us.metamath.org/downloads/symbols.zip",
      "local_path": "symbols/symbols/",
      "count": 2120,
      "mapping_rule": "zip_to_html: exact name match, then substring match, then fuzzy substring",
      "notes": "symbols.zip provides the full glyph catalog (3305 entries) vs HTML chart (1182 entries). Use this for vision glyph matching, not just the HTML chart."
    }
  },
