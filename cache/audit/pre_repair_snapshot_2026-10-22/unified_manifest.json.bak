  "glyph_count": 1182,
  "positional_count": 5007,
  "schema_version": "1.0",
  "notes": "The unified manifest combines the Metamath HTML glyph reference (glyph_entries) with positional extraction outputs (positional_entries). glyph_entries carry named visual glyphs with URLs; positional_entries carry formula/region positions with bboxes, centroids, and text renderings. Cross-reference via manifest_ref fields.",
  "references": {
    "glyph_source": "DATASETS/GIF-and-PNG-Images-for-Math-Symbols.html",
    "glyph_images": "DATASETS/GIF-and-PNG-Images-for-Math-Symbols_files/",
    "positional_sources": [
      "DATASETS/candidates_1907.04931.json",
      "DATASETS/candidates_2104.01277.json",
      "DATASETS/candidates_2206.00364.json",
      "DATASETS/classified_symbols_verify.json",
      "DATASETS/chroma_visual_discrepancies.json"
    ],
    "script_sources": [
      "scripts/chroma_usage_finder.py",
      "scripts/chroma_visual_reader.py",
      "scripts/math_structure_extractor.py",
      "scripts/display_equation_extractor.py"
    ]
  },
  "relationships": {
    "glyph_sources": {
      "metamath_html": {
        "file": "DATASETS/GIF-and-PNG-Images-for-Math-Symbols.html",
        "entries": [
