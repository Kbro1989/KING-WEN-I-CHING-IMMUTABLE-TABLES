      "font_size": 10.0,
      "font_name": "TeXGyrePagellaX-Bold",
      "is_math": false,
      "char_count": 248,
      "block_type": 0
    },
    {
      "block_id": "2605.28615_p9_b9",
      "text": "4.2\nMain Results\n",
      "bbox": [
        70.87,
        398.37,
        162.05,
        409.33
      ],
      "rendered_bbox": [
        283,
