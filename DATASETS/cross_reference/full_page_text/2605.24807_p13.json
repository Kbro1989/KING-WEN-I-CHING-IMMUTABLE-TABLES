    {
      "block_id": "2605.24807_p13_b8",
      "text": "standard CLIP reduces accuracy substantially (78.3\u219272.8 mIoU), confirming\nthat spatially aligned similarity maps are critical for effective conditioning. Freez-\ning CLIPSurgery also degrades performance (73.7 mIoU), indicating that jointly\noptimizing the semantic guide and the segmentation backbone is important.\n",
      "bbox": [
        134.76,
        308.04,
        480.62,
        354.0
      ],
      "rendered_bbox": [
        539,
        1232,
        1922,
