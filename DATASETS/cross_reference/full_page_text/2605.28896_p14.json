    },
    {
      "block_id": "2605.28896_p14_b6",
      "text": "Single seed: All adapters trained with seed 42; seed stability analysis is deferred to future\nwork.\n",
      "bbox": [
        71.61,
        296.08,
        523.31,
        320.62
      ],
      "rendered_bbox": [
        286,
        1184,
        2093,
