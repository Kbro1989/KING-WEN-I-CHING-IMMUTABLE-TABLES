      "char_count": 300,
      "block_type": 0
    },
    {
      "block_id": "2605.28896_p14_b11",
      "text": "8\nRelated Work\n",
      "bbox": [
        72.0,
        531.26,
        194.46,
        545.61
      ],
      "rendered_bbox": [
        288,
        2125,
