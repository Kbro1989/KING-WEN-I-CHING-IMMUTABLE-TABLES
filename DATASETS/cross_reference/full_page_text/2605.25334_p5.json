      "char_count": 891,
      "block_type": 0
    },
    {
      "block_id": "2605.25334_p5_b1",
      "text": "Mcausal[i, j] = \u2212\u221e,\n\u2200i \u2208[Ss, Es], j \u2208[Sm, Em]\n",
      "bbox": [
        201.2,
        176.48,
        410.81,
        187.58
      ],
