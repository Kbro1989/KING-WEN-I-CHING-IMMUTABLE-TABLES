    {
      "block_id": "2605.25334_p5_b4",
      "text": "3.2\nExpert-Guided Visual Grounding\n",
      "bbox": [
        108.0,
        284.81,
        273.25,
        294.78
      ],
      "rendered_bbox": [
        432,
