      "font_size": 9.97,
      "font_name": "CMR10",
      "is_math": false,
      "char_count": 432,
      "block_type": 0
    },
    {
      "block_id": "2605.28896_p1_b7",
      "text": "h\u2206= hadapted \u2212hbase = BAx.\n",
      "bbox": [
        230.45,
        387.63,
        364.83,
        399.22
      ],
      "rendered_bbox": [
        921,
        1550,
