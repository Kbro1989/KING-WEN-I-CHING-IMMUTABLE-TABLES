      "font_name": "NimbusRomNo9L-Regu",
      "is_math": true,
      "char_count": 344,
      "block_type": 0
    },
    {
      "block_id": "2605.25036_p4_b37",
      "text": "4.2. Language Bias Penalty for Direct Preference\nOptimization\n",
      "bbox": [
        307.44,
