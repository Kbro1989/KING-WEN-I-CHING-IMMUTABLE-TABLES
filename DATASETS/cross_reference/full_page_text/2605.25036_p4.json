    {
      "block_id": "2605.25036_p4_b8",
      "text": "The final objective combines both losses, which we adopt\nas our baseline:\n",
      "bbox": [
        55.13,
        153.75,
        289.44,
        175.74
      ],
      "rendered_bbox": [
