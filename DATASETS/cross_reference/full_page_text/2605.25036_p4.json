    },
    {
      "block_id": "2605.25036_p4_b33",
      "text": "The overall VIT training objective is then updated to include\nthis regularization term:\n",
      "bbox": [
        307.13,
        347.19,
        541.44,
        369.04
      ],
      "rendered_bbox": [
        1228,
