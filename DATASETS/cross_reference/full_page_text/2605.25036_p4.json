    },
    {
      "block_id": "2605.25036_p4_b35",
      "text": "VIT = LVIT + \u03b1 \u00b7 LLBR,\n(8)\n",
      "bbox": [
        380.94,
        378.79,
        542.11,
        391.35
      ],
      "rendered_bbox": [
        1523,
        1515,
        2168,
