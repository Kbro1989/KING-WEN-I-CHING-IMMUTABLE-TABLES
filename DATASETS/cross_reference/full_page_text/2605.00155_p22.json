      "char_count": 517,
      "block_type": 0
    },
    {
      "block_id": "2605.00155_p22_b4",
      "text": "sparse. We therefore use \u21131: it gives the local sampled bonus needed for implementation,\n",
      "bbox": [
        72.0,
        250.13,
        524.92,
        263.02
      ],
      "rendered_bbox": [
