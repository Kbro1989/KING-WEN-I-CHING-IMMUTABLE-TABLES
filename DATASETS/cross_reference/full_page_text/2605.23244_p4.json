      "is_math": true,
      "char_count": 285,
      "block_type": 0
    },
    {
      "block_id": "2605.23244_p4_b14",
      "text": "p(yw \u227byl|x) = \u03c3(r(x, yw) \u2212r(x, yl) \u2212\u03b3),\n(6)\n",
      "bbox": [
        83.31,
