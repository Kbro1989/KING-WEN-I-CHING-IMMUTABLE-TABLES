    {
      "block_id": "2605.23244_p4_b65",
      "text": "4.2.1. EFFICIENTLY TRAINING THE CONVEX POLICY\nNETWORK VIA CRONOS\n",
      "bbox": [
        307.69,
        563.32,
        531.34,
        585.24
      ],
      "rendered_bbox": [
        1230,
        2253,
