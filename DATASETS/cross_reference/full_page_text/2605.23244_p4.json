      "font_size": 10.06,
      "font_name": "NimbusRomNo9L-Regu",
      "is_math": false,
      "char_count": 262,
      "block_type": 0
    },
    {
      "block_id": "2605.23244_p4_b63",
      "text": "The key to maximizing COALA\u2019s efficiency in this frame-\nwork is using the recently introduced CRONOS algorithm\n(Feng et al., 2024) to train \u03c0cvx\n",
      "bbox": [
        307.08,
        503.69,
        543.09,
        537.66
      ],
      "rendered_bbox": [
        1228,
        2014,
        2172,
        2150
      ],
