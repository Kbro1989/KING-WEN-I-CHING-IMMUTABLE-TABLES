    {
      "block_id": "2605.25036_p16_b20",
      "text": "Table 11 presents the comprehensive experimental results on the VLFeedback dataset, serving as the extended version of\nTable 4 from the main paper. While the main text demonstrated the efficacy of our method on 1k and 10k subsets, here we\nfurther verify its scalability by conducting an additional experiment using a larger 30k subset.\n",
      "bbox": [
        55.13,
        617.8,
        541.44,
        651.71
      ],
      "rendered_bbox": [
        220,
        2471,
        2165,
