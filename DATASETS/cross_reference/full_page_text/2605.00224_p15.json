    {
      "block_id": "2605.00224_p15_b26",
      "text": "F.1. Multimodal deployment considerations\n",
      "bbox": [
        307.44,
        533.34,
        491.49,
        543.31
      ],
      "rendered_bbox": [
        1229,
        2133,
        1965,
