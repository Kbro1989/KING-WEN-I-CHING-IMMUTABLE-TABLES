      "font_size": 11.84,
      "font_name": "LMRoman12-Regular",
      "is_math": false,
      "char_count": 124,
      "block_type": 0
    },
    {
      "block_id": "2605.00155_p21_b4",
      "text": "Computational overhead.\nThe additional burden is small. During autoregressive\n",
      "bbox": [
        72.0,
        206.5,
        523.37,
        218.59
      ],
      "rendered_bbox": [
        288,
        826,
        2093,
