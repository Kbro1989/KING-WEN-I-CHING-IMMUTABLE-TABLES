      "font_size": 10.8,
      "font_name": "CMR10",
      "is_math": false,
      "char_count": 151,
      "block_type": 0
    },
    {
      "block_id": "2605.28896_p13_b11",
      "text": "1. Cosine similarity: Mean max similarity \u22480.071 across all 268M comparisons, barely above\nrandom (\u22480).\n",
      "bbox": [
        72.0,
        527.2,
        523.29,
        551.8
