      "is_math": true,
      "char_count": 103,
      "block_type": 0
    },
    {
      "block_id": "2605.28896_p13_b12",
      "text": "2. Principal angles: Mean \u224874 with 0% aligned directions \u2014 rigorous subspace-level evidence.\n",
      "bbox": [
        72.0,
        560.77,
        525.4,
        571.83
      ],
