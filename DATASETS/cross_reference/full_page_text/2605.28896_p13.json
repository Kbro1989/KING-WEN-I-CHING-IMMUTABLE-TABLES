      "is_math": false,
      "char_count": 48,
      "block_type": 0
    },
    {
      "block_id": "2605.28896_p13_b10",
      "text": "Three independent analyses consistently indicate that LoRA adapter feature representations are\ngeometrically separated from base model representations:\n",
      "bbox": [
        71.61,
        489.89,
        523.31,
        514.27
      ],
      "rendered_bbox": [
        286,
        1959,
