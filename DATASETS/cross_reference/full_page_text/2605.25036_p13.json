      "char_count": 254,
      "block_type": 0
    },
    {
      "block_id": "2605.25036_p13_b11",
      "text": "Visual QA Tasks. In Table 1, we use abbreviations for the following benchmarks:\n",
      "bbox": [
        55.08,
        397.49,
