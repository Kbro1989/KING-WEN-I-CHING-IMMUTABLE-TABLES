      "is_math": false,
      "char_count": 197,
      "block_type": 0
    },
    {
      "block_id": "2605.25036_p13_b10",
      "text": "\u2022 OCRBench (Liu et al., 2023b): A comprehensive benchmark designed to evaluate a model\u2019s optical character\nrecognition (OCR) and text-centric visual understanding capabilities across a wide variety of scenarios. We report\nscores on its official test set.\n",
      "bbox": [
        66.9,
        349.58,
        541.61,
        383.62
      ],
