      "block_type": 0
    },
    {
      "block_id": "2605.25036_p13_b13",
      "text": "\u2022 VizWiz (Gurari et al., 2018): A visual question answering dataset sourced from questions posed by blind and visually\nimpaired individuals about their surroundings. We evaluate on the validation split.\n",
      "bbox": [
