      "block_type": 0
    },
    {
      "block_id": "2605.25036_p13_b12",
      "text": "\u2022 GQA (Hudson & Manning, 2019): A visual reasoning and compositional question answering benchmark built on\nreal-world images and their associated scene graphs. We report scores on the test-dev-balanced split.\n",
      "bbox": [
        66.9,
        421.34,
        541.44,
        443.42
      ],
