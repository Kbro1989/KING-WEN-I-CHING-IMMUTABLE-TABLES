      "font_name": "NimbusRomNo9L-Regu",
      "is_math": false,
      "char_count": 210,
      "block_type": 0
    },
    {
      "block_id": "2605.25036_p13_b9",
      "text": "\u2022 InfographicVQA (VQAInfo) (Mathew et al., 2022): A dataset for VQA on infographics, which contain complex\nlayouts, diverse text, and rich visual elements. We evaluate using the official val split.\n",
      "bbox": [
        66.9,
        317.44,
        541.69,
        340.77
      ],
      "rendered_bbox": [
        267,
        1269,
