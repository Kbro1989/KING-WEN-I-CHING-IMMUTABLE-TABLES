    },
    {
      "block_id": "2605.24807_p4_b1",
      "text": "\u2013 We analyze co-adaptation dynamics between SAM and CLIP, showing\n",
      "bbox": [
        140.99,
        118.02,
        480.58,
        127.99
      ],
      "rendered_bbox": [
        563,
        472,
        1922,
