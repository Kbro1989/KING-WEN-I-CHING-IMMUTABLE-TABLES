      ],
      "coord_space": "pdf_points",
      "font_size": 9.96,
      "font_name": "SFRM1000",
      "is_math": false,
      "char_count": 166,
      "block_type": 0
    },
    {
      "block_id": "2605.24807_p4_b4",
      "text": "cialized segmentation tasks, supporting interactive (text + spatial prompts)\nand text-only deployment modes under low-label and modest-compute set-\ntings.\n\u2013 We demonstrate strong performance on different comparisons and exper-\n",
      "bbox": [
        140.99,
        201.14,
        480.59,
        246.68
      ],
      "rendered_bbox": [
        563,
        804,
