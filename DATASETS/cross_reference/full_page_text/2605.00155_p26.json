        1764
      ],
      "coord_space": "pdf_points",
      "font_size": 12.07,
      "font_name": "LMRoman12-Regular",
      "is_math": false,
      "char_count": 164,
      "block_type": 0
    },
    {
      "block_id": "2605.00155_p26_b26",
      "text": "only when doing so reduces regret against plausible competitors. When the proxy ranking\nis correct, DRRO therefore preserves more mass on the best-ranked responses.\n",
      "bbox": [
