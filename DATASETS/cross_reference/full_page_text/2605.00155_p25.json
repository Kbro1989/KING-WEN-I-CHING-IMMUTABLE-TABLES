    {
      "block_id": "2605.00155_p25_b3",
      "text": "The experiments make the value-versus-regret distinction visible before the theory names it.\n",
      "bbox": [
        71.58,
        334.39,
        525.55,
        346.22
      ],
      "rendered_bbox": [
        286,
        1337,
