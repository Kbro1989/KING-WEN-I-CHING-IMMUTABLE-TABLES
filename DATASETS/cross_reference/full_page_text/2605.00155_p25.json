      "is_math": false,
      "char_count": 356,
      "block_type": 0
    },
    {
      "block_id": "2605.00155_p25_b5",
      "text": "6.1\nRank-Preserving Proxy Rewards\n",
      "bbox": [
        72.0,
        461.03,
