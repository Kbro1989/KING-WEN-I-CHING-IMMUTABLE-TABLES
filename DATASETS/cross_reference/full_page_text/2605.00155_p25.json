      "font_size": 11.94,
      "font_name": "LMRoman12-Regular",
      "is_math": false,
      "char_count": 87,
      "block_type": 0
    },
    {
      "block_id": "2605.00155_p25_b9",
      "text": "accuracy alone does not determine downstream RLHF performance [Chen et al., 2024]. A\n",
      "bbox": [
        72.0,
        578.29,
        523.76,
        590.13
      ],
      "rendered_bbox": [
