      ],
      "coord_space": "pdf_points",
      "font_size": 11.92,
      "font_name": "LMRoman12-Regular",
      "is_math": false,
      "char_count": 89,
      "block_type": 0
    },
    {
      "block_id": "2605.00155_p25_b8",
      "text": "and ranking correlation remain standard diagnostics [Lambert et al., 2025], even though\n",
      "bbox": [
        72.0,
        560.28,
        523.38,
        572.22
      ],
      "rendered_bbox": [
        288,
        2241,
