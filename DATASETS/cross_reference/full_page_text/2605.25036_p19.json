    {
      "block_id": "2605.25036_p19_b14",
      "text": "D.3. Generalization to State-of-the-Art Architectures\n",
      "bbox": [
        55.44,
        380.02,
        279.53,
        389.98
      ],
      "rendered_bbox": [
