      "font_size": 11.86,
      "font_name": "LMRoman12-Regular",
      "is_math": false,
      "char_count": 421,
      "block_type": 0
    },
    {
      "block_id": "2605.00155_p38_b2",
      "text": "Agarwal and Zhang [2022], Cho and Yang [2024], Bitar [2024], and Fiechtner and Blanchet\n",
