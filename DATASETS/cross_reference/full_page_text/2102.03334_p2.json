    {
      "block_id": "2102.03334_p2_b22",
      "text": "(d) MI > VE = TE\n",
      "bbox": [
        444.97,
        179.96,
        516.11,
        189.14
      ],
      "rendered_bbox": [
        1779,
        719,
        2064,
