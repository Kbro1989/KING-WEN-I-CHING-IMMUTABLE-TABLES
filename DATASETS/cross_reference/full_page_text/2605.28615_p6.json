      "block_type": 0
    },
    {
      "block_id": "2605.28615_p6_b46",
      "text": "Caption Generation. Considering that the generated images may not always perfectly align with the original\ncaptions, we employ a caption generation pipeline to create new captions that better describe the generated\nimages. The pipeline includes the following steps:\n",
      "bbox": [
        70.87,
        636.36,
        541.14,
        673.0
