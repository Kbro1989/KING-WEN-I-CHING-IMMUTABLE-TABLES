      "block_type": 0
    },
    {
      "block_id": "2605.28615_p6_b44",
      "text": "Given the absence of publicly available, high-quality region-annotated composition preference datasets\nsuitable for BiDPO training, we design a data generation pipeline to construct BiComp, a large-scale,\nhigh-quality dataset with regional annotations.\n",
      "bbox": [
        70.87,
        551.13,
        542.38,
        585.96
      ],
