    {
      "block_id": "2605.25334_p13_b3",
      "text": "To support comprehensive spatial reasoning capabilities in our model, we construct the Multi-\nTask Spatial (MTS) instruction tuning dataset by consolidating and re-organizing samples from six\npublicly available spatial intelligence datasets, namely CA-VQA [20], MindCube [23], SPAR-7M\n[24], SpatialMQA [25], SpatialLadder-26K [3], and VSI-590K [26]. The resulting corpus contains\n152,776 instruction-following samples spanning 13 fine-grained spatial task types. Table 3 reports the\ndetailed composition of MTS, including the source dataset(s) and the number of samples associated\nwith each task type.\n",
      "bbox": [
        107.25,
        304.99,
        505.65,
        380.49
      ],
      "rendered_bbox": [
        429,
        1219,
        2022,
        1521
      ],
      "coord_space": "pdf_points",
      "font_size": 10.06,
      "font_name": "NimbusRomNo9L-Regu",
      "is_math": false,
      "char_count": 601,
      "block_type": 0
    },
    {
      "block_id": "2605.25334_p13_b4",
      "text": "A.1\nConstruction Pipeline\n",
      "bbox": [
        108.0,
        395.59,
        225.34,
        405.55
      ],
      "rendered_bbox": [
        432,
        1582,
