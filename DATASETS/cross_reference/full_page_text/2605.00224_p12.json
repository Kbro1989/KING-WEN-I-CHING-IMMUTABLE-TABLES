    {
      "block_id": "2605.00224_p12_b18",
      "text": "where pi is the predicted probability for the positive class\nand yi \u2208{0, 1} is the true label. Lower Brier scores indicate\nbetter-calibrated probabilistic predictions.\n",
      "bbox": [
        55.08,
        250.92,
        289.44,
        285.02
      ],
      "rendered_bbox": [
        220,
        1003,
        1157,
