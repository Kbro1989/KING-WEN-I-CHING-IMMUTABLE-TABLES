    {
      "block_id": "2605.00155_p4_b1",
      "text": "not robustify absolute value alone. Here, regret means the gap between the chosen policy\n",
      "bbox": [
        72.0,
        92.6,
        523.75,
        104.46
      ],
      "rendered_bbox": [
        288,
