      "font_name": "LMRoman12-Regular",
      "is_math": false,
      "char_count": 89,
      "block_type": 0
    },
    {
      "block_id": "2605.00155_p4_b3",
      "text": "This motivates our central idea: robustify regret, not value. Distributionally robust\nregret optimization (DRRO) evaluates a policy by its worst plausible regret against the\n",
      "bbox": [
        72.0,
        128.29,
        523.68,
        158.27
      ],
      "rendered_bbox": [
        288,
        513,
        2094,
