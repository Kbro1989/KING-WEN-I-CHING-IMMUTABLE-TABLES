      "is_math": false,
      "char_count": 88,
      "block_type": 0
    },
    {
      "block_id": "2605.00155_p4_b2",
      "text": "and the best policy that would have been chosen under the same realized plausible reward.\n",
      "bbox": [
        72.0,
        110.55,
        525.57,
        122.38
      ],
      "rendered_bbox": [
        288,
