      "font_name": "LMRoman12-Regular",
      "is_math": false,
      "char_count": 167,
      "block_type": 0
    },
    {
      "block_id": "2605.00155_p4_b15",
      "text": "sampled responses through self-normalized importance sampling. With numerically stable\n",
      "bbox": [
        72.0,
        594.58,
        523.3,
        606.42
      ],
      "rendered_bbox": [
        288,
        2378,
