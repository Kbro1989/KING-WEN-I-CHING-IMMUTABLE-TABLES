      "font_size": 10.87,
      "font_name": "LMRoman10-Italic",
      "is_math": false,
      "char_count": 188,
      "block_type": 0
    },
    {
      "block_id": "2605.24856_p32_b4",
      "text": "paper in isolation \u2014 each concept\u2019s full derivation, motivation, and supporting argument live in the\npaper cited alongside it, not here.\n",
      "bbox": [
        72.0,
        185.3,
        540.03,
        209.68
      ],
      "rendered_bbox": [
        288,
        741,
