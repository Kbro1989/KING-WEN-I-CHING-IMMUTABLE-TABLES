        2698
      ],
      "coord_space": "pdf_points",
      "font_size": 10.91,
      "font_name": "CMBX10",
      "is_math": false,
      "char_count": 99,
      "block_type": 0
    },
    {
      "block_id": "1212.0957_p5_b40",
      "text": "Ym := bm\nfor n = m, m \u22121, . . . , 0 do\n",
