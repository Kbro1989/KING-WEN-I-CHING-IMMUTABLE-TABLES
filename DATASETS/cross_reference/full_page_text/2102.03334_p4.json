      "font_name": "NimbusRomNo9L-Medi",
      "is_math": false,
      "char_count": 34,
      "block_type": 0
    },
    {
      "block_id": "2102.03334_p4_b25",
      "text": "3.1. Model Overview\n",
      "bbox": [
        307.44,
        373.33,
        395.23,
        383.3
      ],
      "rendered_bbox": [
        1229,
        1493,
        1580,
