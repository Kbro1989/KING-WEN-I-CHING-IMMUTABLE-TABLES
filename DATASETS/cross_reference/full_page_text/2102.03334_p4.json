      "text": "\u00aft = [tclass; t1T; \u00b7 \u00b7 \u00b7 ; tLT] + T pos\n(1)\n",
      "bbox": [
        324.12,
        503.45,
        541.44,
        516.25
      ],
      "rendered_bbox": [
        1296,
