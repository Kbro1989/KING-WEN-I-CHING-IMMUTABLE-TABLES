    {
      "block_id": "2605.23244_p21_b42",
      "text": "Table 10. Summary of popular preference fine-tuning methods, respective objective functions, and hyperparameters for completeness.\n",
      "bbox": [
        58.17,
        327.11,
        538.22,
        336.23
      ],
