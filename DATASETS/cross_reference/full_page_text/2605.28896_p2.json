    {
      "block_id": "2605.28896_p2_b1",
      "text": "This gap matters for several reasons. First, safety fine-tuning via LoRA is widely practiced, but if\nthe adapter operates in a representational subspace that base-model interpretability tools cannot\nsee, safety audits may be systematically incomplete. Second, recent work [Yang et al., 2023,\nQi et al., 2023] has demonstrated that safety fine-tuning can be easily undone by subsequent\nfine-tuning, but the mechanistic account of why this occurs is missing. Third, understanding\nwhat LoRA encodes at the feature level is a prerequisite for principled adapter design and\ncontrol.\n",
      "bbox": [
        71.61,
        107.07,
        524.8,
        199.19
      ],
      "rendered_bbox": [
        286,
        428,
        2099,
        796
      ],
      "coord_space": "pdf_points",
      "font_size": 10.8,
      "font_name": "CMR10",
      "is_math": false,
      "char_count": 577,
      "block_type": 0
    },
    {
