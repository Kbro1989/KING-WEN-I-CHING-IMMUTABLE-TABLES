    {
      "block_id": "2102.03334_p6_b4",
      "text": "et al., 2018). Table 1 reports the dataset statistics.\n",
      "bbox": [
        55.44,
        215.4,
        252.25,
        225.36
      ],
      "rendered_bbox": [
