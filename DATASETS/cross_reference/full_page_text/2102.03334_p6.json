      "block_type": 0
    },
    {
      "block_id": "2102.03334_p6_b22",
      "text": "We pre-train ViLT-B/32 for 100K or 200K steps on 64\nNVIDIA V100 GPUs with a batch size of 4,096. For all\ndownstream tasks, we train for ten epochs with a batch size\nof 256 for VQAv2/retrieval tasks and 128 for NLVR2.\n",
      "bbox": [
        306.97,
        362.53,
        541.44,
        408.44
      ],
      "rendered_bbox": [
        1227,
        1450,
        2165,
