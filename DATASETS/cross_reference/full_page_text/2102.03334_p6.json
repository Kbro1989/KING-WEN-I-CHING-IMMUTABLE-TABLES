      "is_math": false,
      "char_count": 216,
      "block_type": 0
    },
    {
      "block_id": "2102.03334_p6_b23",
      "text": "4.3. Classi\ufb01cation Tasks\n",
      "bbox": [
        307.44,
        423.52,
        408.38,
        433.48
      ],
      "rendered_bbox": [
        1229,
        1694,
        1633,
        1733
      ],
      "coord_space": "pdf_points",
