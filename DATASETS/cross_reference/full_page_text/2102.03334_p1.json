    },
    {
      "block_id": "2102.03334_p1_b40",
      "text": "et al., 2020; Li et al., 2020b; Gan et al., 2020; Yu et al.,\n2020; Zhang et al., 2021). These models are pre-trained\nwith image text matching and masked language modeling\nobjectives1 on images and their aligned descriptions, and are\n\ufb01ne-tuned on vision-and-language downstream tasks where\nthe inputs involve two modalities.\n",
      "bbox": [
        307.08,
        517.46,
        542.69,
        587.28
      ],
      "rendered_bbox": [
        1228,
        2069,
        2170,
