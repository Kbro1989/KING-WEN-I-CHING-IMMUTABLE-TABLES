      "block_type": 0
    },
    {
      "block_id": "2605.25036_p14_b8",
      "text": "\u2022 TextCap (Sidorov et al., 2020): A challenging captioning benchmark where models must read and incorporate textual\ninformation present in the image to generate a coherent description. We report the CIDEr score on the val split.\n",
      "bbox": [
        66.9,
        445.42,
        541.44,
        467.39
      ],
