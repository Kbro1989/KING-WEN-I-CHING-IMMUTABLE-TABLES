      "block_type": 0
    },
    {
      "block_id": "2605.25036_p14_b6",
      "text": "Image Caption Tasks. In Table 2, we use abbreviations for the following benchmarks, which evaluate the model\u2019s ability to\ngenerate descriptive text for images:\n",
      "bbox": [
        55.44,
        373.04,
        541.44,
        394.97
      ],
      "rendered_bbox": [
        221,
        1492,
