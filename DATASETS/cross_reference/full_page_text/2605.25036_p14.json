      "is_math": false,
      "char_count": 159,
      "block_type": 0
    },
    {
      "block_id": "2605.25036_p14_b7",
      "text": "\u2022 COCO Captions (CocoCap) (Chen et al., 2015): The standard benchmark for image captioning on everyday scenes,\nbased on the COCO (Common Objects in Context) dataset. We report the CIDEr score on the val split.\n",
      "bbox": [
        66.9,
        411.72,
        542.68,
        433.72
      ],
