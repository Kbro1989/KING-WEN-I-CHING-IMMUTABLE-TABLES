    {
      "block_id": "2605.25036_p14_b3",
      "text": "\u2022 MMMU (Yue et al., 2024): A massive, multi-discipline benchmark that requires expert-level, college-exam-grade\nknowledge to answer questions spanning six core disciplines, from science and engineering to art and design. We\nreport results on the validation set.\n",
      "bbox": [
        66.9,
        242.88,
        541.44,
        276.92
      ],
      "rendered_bbox": [
        267,
        971,
