      "is_math": false,
      "char_count": 261,
      "block_type": 0
    },
    {
      "block_id": "2605.25036_p14_b4",
      "text": "\u2022 MMT-Bench (MMT) (Ying et al., 2024): A benchmark specifically designed for evaluating multi-turn multimodal\nconversation and instruction-following capabilities. We report scores on its official val set.\n",
      "bbox": [
        66.9,
        288.51,
        541.44,
        310.59
      ],
      "rendered_bbox": [
        267,
        1154,
