      "block_type": 0
    },
    {
      "block_id": "2605.00155_p3_b3",
      "text": "The other path improves the proxy itself, for example through reward-model ensembles\n",
      "bbox": [
        89.56,
        467.16,
        523.31,
        479.0
      ],
      "rendered_bbox": [
