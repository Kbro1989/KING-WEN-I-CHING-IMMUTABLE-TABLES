    },
    {
      "block_id": "2605.00155_p15_b17",
      "text": "The exact promptwise DRRO objective contains the maximum maxi(\u02c6ri \u2212\u03b4\u03c0i). On the\n",
      "bbox": [
        71.58,
        454.69,
        523.29,
        468.44
      ],
      "rendered_bbox": [
        286,
        1818,
        2093,
