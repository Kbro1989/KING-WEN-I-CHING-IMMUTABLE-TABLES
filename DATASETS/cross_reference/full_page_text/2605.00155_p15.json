      "font_size": 12.06,
      "font_name": "LMRoman12-Regular",
      "is_math": false,
      "char_count": 167,
      "block_type": 0
    },
    {
      "block_id": "2605.00155_p15_b20",
      "text": "expectation under a soft adversarial distribution, which can be approximated from sampled\ncompletions. For a fixed prompt, define\n",
      "bbox": [
