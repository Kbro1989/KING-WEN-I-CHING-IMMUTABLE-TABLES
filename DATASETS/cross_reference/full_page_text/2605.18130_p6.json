      "font_name": "NimbusRomNo9L-Regu",
      "is_math": true,
      "char_count": 268,
      "block_type": 0
    },
    {
      "block_id": "2605.18130_p6_b5",
      "text": "s = \u03c3 (W2\u03b4(W1(GAP(X))))\n(8)\n",
