{
  "reference_source": {
    "name": "Metamath Symbol Chart",
    "url": "https://us.metamath.org/symbols/symbols.html",
    "image_url": "https://us.metamath.org/symbols/symbols.gif",
    "version": "2-Oct-2015 (last revised)",
    "license": "Public Domain (CC0)",
    "author": "Ian G. Clark, Ph.D.",
    "repository": "https://us.metamath.org/symbols/symbols.html",
    "description": "Collection of 1,179+ bit-mapped transparent GIF/PNG math symbols at 12pt browser font size"
  },
  "usage_guidelines": {
    "purpose": "Supplementary glyph-reference corpus only",
    "role": "Answer 'which glyph does this resemble?'",
    "NOT_role": "Do NOT use to answer 'what role does this symbol play in the paper?'",
    "method": "Compare isolated PDF crops against known symbol shapes for glyph identity; source PDF must establish role",
    "in_scope": [
      "Glyph visual identification (shape comparison)",
      "Label crosswalk (symbol to Unicode, LaTeX, conventional name, Metamath ASCII)",
      "Rendering tests (distinguishability at small sizes, after scaling)",
      "Depth-map experiments (2D silhouette vs generated depth profile)"
    ],
    "out_of_scope": [
      "Paper context",
      "Mathematical role/semantic classification",
      "Expression structure analysis",
      "Ground-truth annotations for expressions"
    ]
  },
  "reference_fields": {
    "source": "Reference source and version (Metamath URL + revision date)",
    "symbol_id": "Metamath index number and ASCII name",
    "original_image": "Path to downloaded symbol image (images/<filename>.gif)",
    "unicode": "Unicode codepoint if applicable",
    "latex": "LaTeX command if applicable",
    "conventional_name": "Standard mathematical name",
    "metamath_name": "Metamath ASCII symbol name",
    "normalization": "Any resizing or normalization applied",
    "source_url": "Direct image URL for the symbol",
    "image_filename": "Local filename",
    "coordinates": "Position on source chart (x1,y1,x2,y2)",
    "description": "Brief description of the symbol"
  },
