{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Phase 2B Disposition Matrix Record",
  "type": "object",
  "required": [
    "candidate_id",
    "paper_id",
    "gate_1_geometry",
    "gate_2_token_alignment",
    "gate_3_operator_delimiter",
    "gate_4_literal_vs_semantic",
    "gate_5_provenance",
    "failure_sources",
    "evidence_ref",
    "final_disposition",
    "reviewer_status"
  ],
  "properties": {
    "candidate_id": { "type": "string", "description": "reference_id from pilot selection" },
    "paper_id": { "type": "string", "enum": ["2009.00031", "2102.03334", "2605.00155", "2605.00224", "2605.06070", "2605.18130", "2605.22715", "2605.23244", "2605.24807", "2605.24856", "2605.25036", "2605.25334", "2605.28615", "2605.28896"] },
    "gate_1_geometry": { "type": "string", "enum": ["pass", "fail", "unresolved"] },
    "gate_2_token_alignment": { "type": "string", "enum": ["pass", "fail", "unresolved"] },
    "gate_3_operator_delimiter": { "type": "string", "enum": ["pass", "fail", "unresolved"] },
    "gate_4_literal_vs_semantic": { "type": "string", "enum": ["literal_match", "semantic_equiv", "mismatch", "unresolved"] },
    "gate_5_provenance": { "type": "string", "enum": ["verified", "partial", "unverified", "unresolved"] },
    "failure_sources": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["geometry/crop", "OCR or extraction", "token order", "operator/structure", "reference mismatch", "provenance", "unresolved/other"]
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "evidence_ref": { "type": "string", "description": "Path to supporting artifact (crop PNG, OCR JSON, etc.)" },
    "final_disposition": { "type": "string", "enum": ["accept", "reject", "unresolved"] },
    "reviewer_status": { "type": "string", "enum": ["pending", "reviewed", "escalated"] },
    "review_notes": { "type": "string", "description": "Free text for unresolved/escalated cases" }
  },
  "additionalProperties": false
}