#usda 1.0
(
    defaultPrim = "SovereignNPC_61"
    metersPerUnit = 1.0
    upAxis = "Y"
)

def Xform "SovereignNPC_61"
(
    kind = "component"
)
{
    double3 xformOp:translate = (4.0, 0.0, 28.0)
    uniform token[] xformOpOrder = ["xformOp:translate"]

    custom string kingwen:name = "Inner Truth"
    custom int kingwen:hexagram_id = 61
    custom string kingwen:category = "transformer"
    custom string kingwen:action = "YIELD"
    custom string kingwen:binary = "110011"
    custom string kingwen:upper_trigram = "Dui"
    custom string kingwen:lower_trigram = "Xun"
    custom float kingwen:vortex_tension = 0.3673

    def Mesh "PointVectorCloud"
    {
        uniform token kind = "pointcloud"
        string kingwen:ply_reference = "../kingwen_avatar_meshes/hex61_phase0.ply"
        uniform token orientation = "rightHanded"
    }
}
