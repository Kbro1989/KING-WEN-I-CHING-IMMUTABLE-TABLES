#usda 1.0
(
    defaultPrim = "SovereignNPC_21"
    metersPerUnit = 1.0
    upAxis = "Y"
)

def Xform "SovereignNPC_21"
(
    kind = "component"
)
{
    double3 xformOp:translate = (4.0, 0.0, -12.0)
    uniform token[] xformOpOrder = ["xformOp:translate"]

    custom string kingwen:name = "Biting Through"
    custom int kingwen:hexagram_id = 21
    custom string kingwen:category = "transformer"
    custom string kingwen:action = "ASSERT"
    custom string kingwen:binary = "100101"
    custom string kingwen:upper_trigram = "Zhen"
    custom string kingwen:lower_trigram = "Li"
    custom float kingwen:vortex_tension = 0.102

    def Mesh "PointVectorCloud"
    {
        uniform token kind = "pointcloud"
        string kingwen:ply_reference = "../kingwen_avatar_meshes/hex21_phase0.ply"
        uniform token orientation = "rightHanded"
    }
}
