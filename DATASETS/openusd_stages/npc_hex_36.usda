#usda 1.0
(
    defaultPrim = "SovereignNPC_36"
    metersPerUnit = 1.0
    upAxis = "Y"
)

def Xform "SovereignNPC_36"
(
    kind = "component"
)
{
    double3 xformOp:translate = (-4.0, 0.0, 4.0)
    uniform token[] xformOpOrder = ["xformOp:translate"]

    custom string kingwen:name = "Darkening of the Light"
    custom int kingwen:hexagram_id = 36
    custom string kingwen:category = "dissipator"
    custom string kingwen:action = "WAIT"
    custom string kingwen:binary = "101000"
    custom string kingwen:upper_trigram = "Li"
    custom string kingwen:lower_trigram = "Kun"
    custom float kingwen:vortex_tension = 0.0

    def Mesh "PointVectorCloud"
    {
        uniform token kind = "pointcloud"
        string kingwen:ply_reference = "../kingwen_avatar_meshes/hex36_phase0.ply"
        uniform token orientation = "rightHanded"
    }
}
