#usda 1.0
(
    defaultPrim = "SovereignNPC_27"
    metersPerUnit = 1.0
    upAxis = "Y"
)

def Xform "SovereignNPC_27"
(
    kind = "component"
)
{
    double3 xformOp:translate = (-12.0, 0.0, -4.0)
    uniform token[] xformOpOrder = ["xformOp:translate"]

    custom string kingwen:name = "Corners of the Mouth"
    custom int kingwen:hexagram_id = 27
    custom string kingwen:category = "transformer"
    custom string kingwen:action = "YIELD"
    custom string kingwen:binary = "100001"
    custom string kingwen:upper_trigram = "Zhen"
    custom string kingwen:lower_trigram = "Gen"
    custom float kingwen:vortex_tension = 0.0816

    def Mesh "PointVectorCloud"
    {
        uniform token kind = "pointcloud"
        string kingwen:ply_reference = "../kingwen_avatar_meshes/hex27_phase0.ply"
        uniform token orientation = "rightHanded"
    }
}
