#usda 1.0
(
    defaultPrim = "SovereignNPC_56"
    metersPerUnit = 1.0
    upAxis = "Y"
)

def Xform "SovereignNPC_56"
(
    kind = "component"
)
{
    double3 xformOp:translate = (28.0, 0.0, 20.0)
    uniform token[] xformOpOrder = ["xformOp:translate"]

    custom string kingwen:name = "The Wanderer"
    custom int kingwen:hexagram_id = 56
    custom string kingwen:category = "dissipator"
    custom string kingwen:action = "ADAPT"
    custom string kingwen:binary = "101100"
    custom string kingwen:upper_trigram = "Gen"
    custom string kingwen:lower_trigram = "Li"
    custom float kingwen:vortex_tension = 0.102

    def Mesh "PointVectorCloud"
    {
        uniform token kind = "pointcloud"
        string kingwen:ply_reference = "../kingwen_avatar_meshes/hex56_phase0.ply"
        uniform token orientation = "rightHanded"
    }
}
