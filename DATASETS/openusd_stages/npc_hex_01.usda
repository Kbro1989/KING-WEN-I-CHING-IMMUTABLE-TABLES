#usda 1.0
(
    defaultPrim = "SovereignNPC_01"
    metersPerUnit = 1.0
    upAxis = "Y"
)

def Xform "SovereignNPC_01"
(
    kind = "component"
)
{
    double3 xformOp:translate = (-28.0, 0.0, -28.0)
    uniform token[] xformOpOrder = ["xformOp:translate"]

    custom string kingwen:name = "The Creative"
    custom int kingwen:hexagram_id = 1
    custom string kingwen:category = "sovereign"
    custom string kingwen:action = "ASSERT"
    custom string kingwen:binary = "111111"
    custom string kingwen:upper_trigram = "Qian"
    custom string kingwen:lower_trigram = "Qian"
    custom float kingwen:vortex_tension = 1.0

    def Mesh "PointVectorCloud"
    {
        uniform token kind = "pointcloud"
        string kingwen:ply_reference = "../kingwen_avatar_meshes/hex01_phase0.ply"
        uniform token orientation = "rightHanded"
    }
}
