#usda 1.0
(
    defaultPrim = "SovereignNPC_39"
    metersPerUnit = 1.0
    upAxis = "Y"
)

def Xform "SovereignNPC_39"
(
    kind = "component"
)
{
    double3 xformOp:translate = (20.0, 0.0, 4.0)
    uniform token[] xformOpOrder = ["xformOp:translate"]

    custom string kingwen:name = "Obstruction"
    custom int kingwen:hexagram_id = 39
    custom string kingwen:category = "dissipator"
    custom string kingwen:action = "WAIT"
    custom string kingwen:binary = "010100"
    custom string kingwen:upper_trigram = "Gen"
    custom string kingwen:lower_trigram = "Kan"
    custom float kingwen:vortex_tension = 0.0408

    def Mesh "PointVectorCloud"
    {
        uniform token kind = "pointcloud"
        string kingwen:ply_reference = "../kingwen_avatar_meshes/hex39_phase0.ply"
        uniform token orientation = "rightHanded"
    }
}
