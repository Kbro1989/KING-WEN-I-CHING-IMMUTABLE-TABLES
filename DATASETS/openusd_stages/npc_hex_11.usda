#usda 1.0
(
    defaultPrim = "SovereignNPC_11"
    metersPerUnit = 1.0
    upAxis = "Y"
)

def Xform "SovereignNPC_11"
(
    kind = "component"
)
{
    double3 xformOp:translate = (-12.0, 0.0, -20.0)
    uniform token[] xformOpOrder = ["xformOp:translate"]

    custom string kingwen:name = "Peace"
    custom int kingwen:hexagram_id = 11
    custom string kingwen:category = "transformer"
    custom string kingwen:action = "YIELD"
    custom string kingwen:binary = "000111"
    custom string kingwen:upper_trigram = "Qian"
    custom string kingwen:lower_trigram = "Kun"
    custom float kingwen:vortex_tension = 0.0

    def Mesh "PointVectorCloud"
    {
        uniform token kind = "pointcloud"
        string kingwen:ply_reference = "../kingwen_avatar_meshes/hex11_phase0.ply"
        uniform token orientation = "rightHanded"
    }
}
