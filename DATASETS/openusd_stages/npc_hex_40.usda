#usda 1.0
(
    defaultPrim = "SovereignNPC_40"
    metersPerUnit = 1.0
    upAxis = "Y"
)

def Xform "SovereignNPC_40"
(
    kind = "component"
)
{
    double3 xformOp:translate = (28.0, 0.0, 4.0)
    uniform token[] xformOpOrder = ["xformOp:translate"]

    custom string kingwen:name = "Deliverance"
    custom int kingwen:hexagram_id = 40
    custom string kingwen:category = "transformer"
    custom string kingwen:action = "ADAPT"
    custom string kingwen:binary = "001010"
    custom string kingwen:upper_trigram = "Kan"
    custom string kingwen:lower_trigram = "Zhen"
    custom float kingwen:vortex_tension = 0.1633

    def Mesh "PointVectorCloud"
    {
        uniform token kind = "pointcloud"
        string kingwen:ply_reference = "../kingwen_avatar_meshes/hex40_phase0.ply"
        uniform token orientation = "rightHanded"
    }
}
