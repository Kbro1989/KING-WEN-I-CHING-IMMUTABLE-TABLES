#usda 1.0
(
    defaultPrim = "SovereignNPC_12"
    metersPerUnit = 1.0
    upAxis = "Y"
)

def Xform "SovereignNPC_12"
(
    kind = "component"
)
{
    double3 xformOp:translate = (-4.0, 0.0, -20.0)
    uniform token[] xformOpOrder = ["xformOp:translate"]

    custom string kingwen:name = "Standstill"
    custom int kingwen:hexagram_id = 12
    custom string kingwen:category = "boundary"
    custom string kingwen:action = "WAIT"
    custom string kingwen:binary = "111000"
    custom string kingwen:upper_trigram = "Kun"
    custom string kingwen:lower_trigram = "Qian"
    custom float kingwen:vortex_tension = 0.0

    def Mesh "PointVectorCloud"
    {
        uniform token kind = "pointcloud"
        string kingwen:ply_reference = "../kingwen_avatar_meshes/hex12_phase0.ply"
        uniform token orientation = "rightHanded"
    }
}
