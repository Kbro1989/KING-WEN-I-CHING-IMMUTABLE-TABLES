#usda 1.0
(
    defaultPrim = "SovereignNPC_25"
    metersPerUnit = 1.0
    upAxis = "Y"
)

def Xform "SovereignNPC_25"
(
    kind = "component"
)
{
    double3 xformOp:translate = (-28.0, 0.0, -4.0)
    uniform token[] xformOpOrder = ["xformOp:translate"]

    custom string kingwen:name = "Innocence"
    custom int kingwen:hexagram_id = 25
    custom string kingwen:category = "sovereign"
    custom string kingwen:action = "ASSERT"
    custom string kingwen:binary = "100111"
    custom string kingwen:upper_trigram = "Zhen"
    custom string kingwen:lower_trigram = "Qian"
    custom float kingwen:vortex_tension = 0.1429

    def Mesh "PointVectorCloud"
    {
        uniform token kind = "pointcloud"
        string kingwen:ply_reference = "../kingwen_avatar_meshes/hex25_phase0.ply"
        uniform token orientation = "rightHanded"
    }
}
