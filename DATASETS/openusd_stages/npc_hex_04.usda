#usda 1.0
(
    defaultPrim = "SovereignNPC_04"
    metersPerUnit = 1.0
    upAxis = "Y"
)

def Xform "SovereignNPC_04"
(
    kind = "component"
)
{
    double3 xformOp:translate = (-4.0, 0.0, -28.0)
    uniform token[] xformOpOrder = ["xformOp:translate"]

    custom string kingwen:name = "Youthful Folly"
    custom int kingwen:hexagram_id = 4
    custom string kingwen:category = "transformer"
    custom string kingwen:action = "WAIT"
    custom string kingwen:binary = "100010"
    custom string kingwen:upper_trigram = "Kan"
    custom string kingwen:lower_trigram = "Gen"
    custom float kingwen:vortex_tension = 0.0408

    def Mesh "PointVectorCloud"
    {
        uniform token kind = "pointcloud"
        string kingwen:ply_reference = "../kingwen_avatar_meshes/hex04_phase0.ply"
        uniform token orientation = "rightHanded"
    }
}
