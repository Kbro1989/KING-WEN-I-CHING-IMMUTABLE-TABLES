#usda 1.0
(
    defaultPrim = "SovereignNPC_50"
    metersPerUnit = 1.0
    upAxis = "Y"
)

def Xform "SovereignNPC_50"
(
    kind = "component"
)
{
    custom string kingwen:category = "sovereign"
    custom string kingwen:action = "ASSERT"
    custom int kingwen:hexagram_id = 50
    def Mesh "PointVectorCloud"
    {
        uniform token kind = "pointcloud"
        string kingwen:ply_reference = "../kingwen_avatar_meshes/hex50_phase0.ply"
        uniform token orientation = "rightHanded"
    }
}
