#usda 1.0
(
    defaultPrim = "SovereignNPC_50"
    metersPerUnit = 1.0
    upAxis = "Y"
)

def Xform "SovereignNPC_50"
(
    kind = "component"
)
{
    double3 xformOp:translate = (-20.0, 0.0, 20.0)
    uniform token[] xformOpOrder = ["xformOp:translate"]

    custom string kingwen:name = "The Cauldron"
    custom int kingwen:hexagram_id = 50
    custom string kingwen:category = "sovereign"
    custom string kingwen:action = "ASSERT"
    custom string kingwen:binary = "011101"
    custom string kingwen:upper_trigram = "Xun"
    custom string kingwen:lower_trigram = "Li"
    custom float kingwen:vortex_tension = 0.6122

    def Mesh "PointVectorCloud"
    {
        uniform token kind = "pointcloud"
        string kingwen:ply_reference = "../kingwen_avatar_meshes/hex50_phase0.ply"
        uniform token orientation = "rightHanded"
    }
}
