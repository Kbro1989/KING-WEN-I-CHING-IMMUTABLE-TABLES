#usda 1.0
(
    defaultPrim = "SovereignNPC_28"
    metersPerUnit = 1.0
    upAxis = "Y"
)

def Xform "SovereignNPC_28"
(
    kind = "component"
)
{
    double3 xformOp:translate = (-4.0, 0.0, -4.0)
    uniform token[] xformOpOrder = ["xformOp:translate"]

    custom string kingwen:name = "Preponderance of the Great"
    custom int kingwen:hexagram_id = 28
    custom string kingwen:category = "dissipator"
    custom string kingwen:action = "ADAPT"
    custom string kingwen:binary = "011110"
    custom string kingwen:upper_trigram = "Xun"
    custom string kingwen:lower_trigram = "Dui"
    custom float kingwen:vortex_tension = 0.3673

    def Mesh "PointVectorCloud"
    {
        uniform token kind = "pointcloud"
        string kingwen:ply_reference = "../kingwen_avatar_meshes/hex28_phase0.ply"
        uniform token orientation = "rightHanded"
    }
}
