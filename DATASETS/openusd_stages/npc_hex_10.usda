#usda 1.0
(
    defaultPrim = "SovereignNPC_10"
    metersPerUnit = 1.0
    upAxis = "Y"
)

def Xform "SovereignNPC_10"
(
    kind = "component"
)
{
    double3 xformOp:translate = (-20.0, 0.0, -20.0)
    uniform token[] xformOpOrder = ["xformOp:translate"]

    custom string kingwen:name = "Treading"
    custom int kingwen:hexagram_id = 10
    custom string kingwen:category = "sovereign"
    custom string kingwen:action = "ADAPT"
    custom string kingwen:binary = "111011"
    custom string kingwen:upper_trigram = "Dui"
    custom string kingwen:lower_trigram = "Qian"
    custom float kingwen:vortex_tension = 0.8571

    def Mesh "PointVectorCloud"
    {
        uniform token kind = "pointcloud"
        string kingwen:ply_reference = "../kingwen_avatar_meshes/hex10_phase0.ply"
        uniform token orientation = "rightHanded"
    }
}
