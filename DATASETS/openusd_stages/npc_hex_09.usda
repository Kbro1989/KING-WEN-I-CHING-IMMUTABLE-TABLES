#usda 1.0
(
    defaultPrim = "SovereignNPC_09"
    metersPerUnit = 1.0
    upAxis = "Y"
)

def Xform "SovereignNPC_09"
(
    kind = "component"
)
{
    double3 xformOp:translate = (-28.0, 0.0, -20.0)
    uniform token[] xformOpOrder = ["xformOp:translate"]

    custom string kingwen:name = "Taming Power of the Small"
    custom int kingwen:hexagram_id = 9
    custom string kingwen:category = "dissipator"
    custom string kingwen:action = "ADAPT"
    custom string kingwen:binary = "110111"
    custom string kingwen:upper_trigram = "Qian"
    custom string kingwen:lower_trigram = "Xun"
    custom float kingwen:vortex_tension = 0.4286

    def Mesh "PointVectorCloud"
    {
        uniform token kind = "pointcloud"
        string kingwen:ply_reference = "../kingwen_avatar_meshes/hex09_phase0.ply"
        uniform token orientation = "rightHanded"
    }
}
