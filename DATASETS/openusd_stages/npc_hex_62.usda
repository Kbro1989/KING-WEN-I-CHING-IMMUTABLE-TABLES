#usda 1.0
(
    defaultPrim = "SovereignNPC_62"
    metersPerUnit = 1.0
    upAxis = "Y"
)

def Xform "SovereignNPC_62"
(
    kind = "component"
)
{
    double3 xformOp:translate = (12.0, 0.0, 28.0)
    uniform token[] xformOpOrder = ["xformOp:translate"]

    custom string kingwen:name = "Preponderance of the Small"
    custom int kingwen:hexagram_id = 62
    custom string kingwen:category = "dissipator"
    custom string kingwen:action = "WAIT"
    custom string kingwen:binary = "001100"
    custom string kingwen:upper_trigram = "Zhen"
    custom string kingwen:lower_trigram = "Gen"
    custom float kingwen:vortex_tension = 0.0816

    def Mesh "PointVectorCloud"
    {
        uniform token kind = "pointcloud"
        string kingwen:ply_reference = "../kingwen_avatar_meshes/hex62_phase0.ply"
        uniform token orientation = "rightHanded"
    }
}
