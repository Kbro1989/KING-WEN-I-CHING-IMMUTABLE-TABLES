#usda 1.0
(
    defaultPrim = "SovereignNPC_52"
    metersPerUnit = 1.0
    upAxis = "Y"
)

def Xform "SovereignNPC_52"
(
    kind = "component"
)
{
    double3 xformOp:translate = (-4.0, 0.0, 20.0)
    uniform token[] xformOpOrder = ["xformOp:translate"]

    custom string kingwen:name = "Keeping Still"
    custom int kingwen:hexagram_id = 52
    custom string kingwen:category = "boundary"
    custom string kingwen:action = "WAIT"
    custom string kingwen:binary = "001001"
    custom string kingwen:upper_trigram = "Gen"
    custom string kingwen:lower_trigram = "Gen"
    custom float kingwen:vortex_tension = 0.3265

    def Mesh "PointVectorCloud"
    {
        uniform token kind = "pointcloud"
        string kingwen:ply_reference = "../kingwen_avatar_meshes/hex52_phase0.ply"
        uniform token orientation = "rightHanded"
    }
}
