#usda 1.0
(
    defaultPrim = "SovereignNPC_29"
    metersPerUnit = 1.0
    upAxis = "Y"
)

def Xform "SovereignNPC_29"
(
    kind = "component"
)
{
    double3 xformOp:translate = (4.0, 0.0, -4.0)
    uniform token[] xformOpOrder = ["xformOp:translate"]

    custom string kingwen:name = "The Abysmal"
    custom int kingwen:hexagram_id = 29
    custom string kingwen:category = "dissipator"
    custom string kingwen:action = "WAIT"
    custom string kingwen:binary = "010010"
    custom string kingwen:upper_trigram = "Kan"
    custom string kingwen:lower_trigram = "Kan"
    custom float kingwen:vortex_tension = 0.0816

    def Mesh "PointVectorCloud"
    {
        uniform token kind = "pointcloud"
        string kingwen:ply_reference = "../kingwen_avatar_meshes/hex29_phase0.ply"
        uniform token orientation = "rightHanded"
    }
}
