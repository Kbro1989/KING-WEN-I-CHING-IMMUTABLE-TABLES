#usda 1.0
(
    defaultPrim = "SovereignNPC_46"
    metersPerUnit = 1.0
    upAxis = "Y"
)

def Xform "SovereignNPC_46"
(
    kind = "component"
)
{
    double3 xformOp:translate = (12.0, 0.0, 12.0)
    uniform token[] xformOpOrder = ["xformOp:translate"]

    custom string kingwen:name = "Pushing Upward"
    custom int kingwen:hexagram_id = 46
    custom string kingwen:category = "transformer"
    custom string kingwen:action = "ADAPT"
    custom string kingwen:binary = "011000"
    custom string kingwen:upper_trigram = "Xun"
    custom string kingwen:lower_trigram = "Kun"
    custom float kingwen:vortex_tension = 0.0

    def Mesh "PointVectorCloud"
    {
        uniform token kind = "pointcloud"
        string kingwen:ply_reference = "../kingwen_avatar_meshes/hex46_phase0.ply"
        uniform token orientation = "rightHanded"
    }
}
