#usda 1.0
(
    defaultPrim = "SovereignNPC_19"
    metersPerUnit = 1.0
    upAxis = "Y"
)

def Xform "SovereignNPC_19"
(
    kind = "component"
)
{
    double3 xformOp:translate = (-12.0, 0.0, -12.0)
    uniform token[] xformOpOrder = ["xformOp:translate"]

    custom string kingwen:name = "Approach"
    custom int kingwen:hexagram_id = 19
    custom string kingwen:category = "transformer"
    custom string kingwen:action = "YIELD"
    custom string kingwen:binary = "110000"
    custom string kingwen:upper_trigram = "Kun"
    custom string kingwen:lower_trigram = "Dui"
    custom float kingwen:vortex_tension = 0.0

    def Mesh "PointVectorCloud"
    {
        uniform token kind = "pointcloud"
        string kingwen:ply_reference = "../kingwen_avatar_meshes/hex19_phase0.ply"
        uniform token orientation = "rightHanded"
    }
}
