#usda 1.0
(
    defaultPrim = "SovereignNPC_06"
    metersPerUnit = 1.0
    upAxis = "Y"
)

def Xform "SovereignNPC_06"
(
    kind = "component"
)
{
    double3 xformOp:translate = (12.0, 0.0, -28.0)
    uniform token[] xformOpOrder = ["xformOp:translate"]

    custom string kingwen:name = "Conflict"
    custom int kingwen:hexagram_id = 6
    custom string kingwen:category = "transformer"
    custom string kingwen:action = "ASSERT"
    custom string kingwen:binary = "111010"
    custom string kingwen:upper_trigram = "Kan"
    custom string kingwen:lower_trigram = "Qian"
    custom float kingwen:vortex_tension = 0.2857

    def Mesh "PointVectorCloud"
    {
        uniform token kind = "pointcloud"
        string kingwen:ply_reference = "../kingwen_avatar_meshes/hex06_phase0.ply"
        uniform token orientation = "rightHanded"
    }
}
