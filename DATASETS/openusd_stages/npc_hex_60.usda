#usda 1.0
(
    defaultPrim = "SovereignNPC_60"
    metersPerUnit = 1.0
    upAxis = "Y"
)

def Xform "SovereignNPC_60"
(
    kind = "component"
)
{
    double3 xformOp:translate = (-4.0, 0.0, 28.0)
    uniform token[] xformOpOrder = ["xformOp:translate"]

    custom string kingwen:name = "Limitation"
    custom int kingwen:hexagram_id = 60
    custom string kingwen:category = "boundary"
    custom string kingwen:action = "WAIT"
    custom string kingwen:binary = "110010"
    custom string kingwen:upper_trigram = "Dui"
    custom string kingwen:lower_trigram = "Kan"
    custom float kingwen:vortex_tension = 0.1224

    def Mesh "PointVectorCloud"
    {
        uniform token kind = "pointcloud"
        string kingwen:ply_reference = "../kingwen_avatar_meshes/hex60_phase0.ply"
        uniform token orientation = "rightHanded"
    }
}
