#usda 1.0
(
    defaultPrim = "SovereignNPC_48"
    metersPerUnit = 1.0
    upAxis = "Y"
)

def Xform "SovereignNPC_48"
(
    kind = "component"
)
{
    double3 xformOp:translate = (28.0, 0.0, 12.0)
    uniform token[] xformOpOrder = ["xformOp:translate"]

    custom string kingwen:name = "The Well"
    custom int kingwen:hexagram_id = 48
    custom string kingwen:category = "boundary"
    custom string kingwen:action = "YIELD"
    custom string kingwen:binary = "011010"
    custom string kingwen:upper_trigram = "Xun"
    custom string kingwen:lower_trigram = "Kan"
    custom float kingwen:vortex_tension = 0.2449

    def Mesh "PointVectorCloud"
    {
        uniform token kind = "pointcloud"
        string kingwen:ply_reference = "../kingwen_avatar_meshes/hex48_phase0.ply"
        uniform token orientation = "rightHanded"
    }
}
