#usda 1.0
(
    defaultPrim = "SovereignNPC_30"
    metersPerUnit = 1.0
    upAxis = "Y"
)

def Xform "SovereignNPC_30"
(
    kind = "component"
)
{
    double3 xformOp:translate = (12.0, 0.0, -4.0)
    uniform token[] xformOpOrder = ["xformOp:translate"]

    custom string kingwen:name = "The Clinging"
    custom int kingwen:hexagram_id = 30
    custom string kingwen:category = "boundary"
    custom string kingwen:action = "ADAPT"
    custom string kingwen:binary = "101101"
    custom string kingwen:upper_trigram = "Li"
    custom string kingwen:lower_trigram = "Li"
    custom float kingwen:vortex_tension = 0.5102

    def Mesh "PointVectorCloud"
    {
        uniform token kind = "pointcloud"
        string kingwen:ply_reference = "../kingwen_avatar_meshes/hex30_phase0.ply"
        uniform token orientation = "rightHanded"
    }
}
