#usda 1.0
(
    defaultPrim = "SovereignNPC_57"
    metersPerUnit = 1.0
    upAxis = "Y"
)

def Xform "SovereignNPC_57"
(
    kind = "component"
)
{
    double3 xformOp:translate = (-28.0, 0.0, 28.0)
    uniform token[] xformOpOrder = ["xformOp:translate"]

    custom string kingwen:name = "The Gentle"
    custom int kingwen:hexagram_id = 57
    custom string kingwen:category = "boundary"
    custom string kingwen:action = "YIELD"
    custom string kingwen:binary = "011011"
    custom string kingwen:upper_trigram = "Xun"
    custom string kingwen:lower_trigram = "Xun"
    custom float kingwen:vortex_tension = 0.7347

    def Mesh "PointVectorCloud"
    {
        uniform token kind = "pointcloud"
        string kingwen:ply_reference = "../kingwen_avatar_meshes/hex57_phase0.ply"
        uniform token orientation = "rightHanded"
    }
}
