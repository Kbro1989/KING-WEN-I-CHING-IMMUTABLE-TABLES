#usda 1.0
(
    defaultPrim = "SovereignNPC_53"
    metersPerUnit = 1.0
    upAxis = "Y"
)

def Xform "SovereignNPC_53"
(
    kind = "component"
)
{
    double3 xformOp:translate = (4.0, 0.0, 20.0)
    uniform token[] xformOpOrder = ["xformOp:translate"]

    custom string kingwen:name = "Development"
    custom int kingwen:hexagram_id = 53
    custom string kingwen:category = "transformer"
    custom string kingwen:action = "ADAPT"
    custom string kingwen:binary = "001011"
    custom string kingwen:upper_trigram = "Gen"
    custom string kingwen:lower_trigram = "Xun"
    custom float kingwen:vortex_tension = 0.4898

    def Mesh "PointVectorCloud"
    {
        uniform token kind = "pointcloud"
        string kingwen:ply_reference = "../kingwen_avatar_meshes/hex53_phase0.ply"
        uniform token orientation = "rightHanded"
    }
}
