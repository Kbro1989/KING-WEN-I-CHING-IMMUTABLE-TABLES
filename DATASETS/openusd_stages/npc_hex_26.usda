#usda 1.0
(
    defaultPrim = "SovereignNPC_26"
    metersPerUnit = 1.0
    upAxis = "Y"
)

def Xform "SovereignNPC_26"
(
    kind = "component"
)
{
    double3 xformOp:translate = (-20.0, 0.0, -4.0)
    uniform token[] xformOpOrder = ["xformOp:translate"]

    custom string kingwen:name = "Taming Power of the Great"
    custom int kingwen:hexagram_id = 26
    custom string kingwen:category = "boundary"
    custom string kingwen:action = "ADAPT"
    custom string kingwen:binary = "111001"
    custom string kingwen:upper_trigram = "Qian"
    custom string kingwen:lower_trigram = "Gen"
    custom float kingwen:vortex_tension = 0.5714

    def Mesh "PointVectorCloud"
    {
        uniform token kind = "pointcloud"
        string kingwen:ply_reference = "../kingwen_avatar_meshes/hex26_phase0.ply"
        uniform token orientation = "rightHanded"
    }
}
