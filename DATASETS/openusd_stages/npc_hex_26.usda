#usda 1.0
(
    defaultPrim = "SovereignNPC_26"
    metersPerUnit = 1.0
    upAxis = "Y"
)

def Xform "SovereignNPC_26"
(
    kind = "component"
)
{
    custom string kingwen:category = "boundary"
    custom string kingwen:action = "ADAPT"
    custom int kingwen:hexagram_id = 26
    def Mesh "PointVectorCloud"
    {
        uniform token kind = "pointcloud"
        string kingwen:ply_reference = "../kingwen_avatar_meshes/hex26_phase0.ply"
        uniform token orientation = "rightHanded"
    }
}
