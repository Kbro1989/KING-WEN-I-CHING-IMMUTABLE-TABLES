#usda 1.0
(
    defaultPrim = "SovereignNPC_23"
    metersPerUnit = 1.0
    upAxis = "Y"
)

def Xform "SovereignNPC_23"
(
    kind = "component"
)
{
    double3 xformOp:translate = (20.0, 0.0, -12.0)
    uniform token[] xformOpOrder = ["xformOp:translate"]

    custom string kingwen:name = "Splitting Apart"
    custom int kingwen:hexagram_id = 23
    custom string kingwen:category = "dissipator"
    custom string kingwen:action = "WAIT"
    custom string kingwen:binary = "000001"
    custom string kingwen:upper_trigram = "Kun"
    custom string kingwen:lower_trigram = "Gen"
    custom float kingwen:vortex_tension = 0.0

    def Mesh "PointVectorCloud"
    {
        uniform token kind = "pointcloud"
        string kingwen:ply_reference = "../kingwen_avatar_meshes/hex23_phase0.ply"
        uniform token orientation = "rightHanded"
    }
}
