#usda 1.0
(
    defaultPrim = "SovereignNPC_03"
    metersPerUnit = 1.0
    upAxis = "Y"
)

def Xform "SovereignNPC_03"
(
    kind = "component"
)
{
    double3 xformOp:translate = (-12.0, 0.0, -28.0)
    uniform token[] xformOpOrder = ["xformOp:translate"]

    custom string kingwen:name = "Difficulty at the Beginning"
    custom int kingwen:hexagram_id = 3
    custom string kingwen:category = "dissipator"
    custom string kingwen:action = "ADAPT"
    custom string kingwen:binary = "010001"
    custom string kingwen:upper_trigram = "Zhen"
    custom string kingwen:lower_trigram = "Kan"
    custom float kingwen:vortex_tension = 0.1633

    def Mesh "PointVectorCloud"
    {
        uniform token kind = "pointcloud"
        string kingwen:ply_reference = "../kingwen_avatar_meshes/hex03_phase0.ply"
        uniform token orientation = "rightHanded"
    }
}
