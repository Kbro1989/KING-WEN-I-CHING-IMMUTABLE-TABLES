#usda 1.0
(
    defaultPrim = "SovereignNPC_59"
    metersPerUnit = 1.0
    upAxis = "Y"
)

def Xform "SovereignNPC_59"
(
    kind = "component"
)
{
    double3 xformOp:translate = (-12.0, 0.0, 28.0)
    uniform token[] xformOpOrder = ["xformOp:translate"]

    custom string kingwen:name = "Dispersion"
    custom int kingwen:hexagram_id = 59
    custom string kingwen:category = "dissipator"
    custom string kingwen:action = "ADAPT"
    custom string kingwen:binary = "010011"
    custom string kingwen:upper_trigram = "Kan"
    custom string kingwen:lower_trigram = "Xun"
    custom float kingwen:vortex_tension = 0.2449

    def Mesh "PointVectorCloud"
    {
        uniform token kind = "pointcloud"
        string kingwen:ply_reference = "../kingwen_avatar_meshes/hex59_phase0.ply"
        uniform token orientation = "rightHanded"
    }
}
