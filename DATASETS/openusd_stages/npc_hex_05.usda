#usda 1.0
(
    defaultPrim = "SovereignNPC_05"
    metersPerUnit = 1.0
    upAxis = "Y"
)

def Xform "SovereignNPC_05"
(
    kind = "component"
)
{
    double3 xformOp:translate = (4.0, 0.0, -28.0)
    uniform token[] xformOpOrder = ["xformOp:translate"]

    custom string kingwen:name = "Waiting"
    custom int kingwen:hexagram_id = 5
    custom string kingwen:category = "dissipator"
    custom string kingwen:action = "WAIT"
    custom string kingwen:binary = "010111"
    custom string kingwen:upper_trigram = "Qian"
    custom string kingwen:lower_trigram = "Kan"
    custom float kingwen:vortex_tension = 0.2857

    def Mesh "PointVectorCloud"
    {
        uniform token kind = "pointcloud"
        string kingwen:ply_reference = "../kingwen_avatar_meshes/hex05_phase0.ply"
        uniform token orientation = "rightHanded"
    }
}
