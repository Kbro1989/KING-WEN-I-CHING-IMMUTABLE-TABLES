#usda 1.0
(
    defaultPrim = "SovereignNPC_44"
    metersPerUnit = 1.0
    upAxis = "Y"
)

def Xform "SovereignNPC_44"
(
    kind = "component"
)
{
    double3 xformOp:translate = (-4.0, 0.0, 12.0)
    uniform token[] xformOpOrder = ["xformOp:translate"]

    custom string kingwen:name = "Coming to Meet"
    custom int kingwen:hexagram_id = 44
    custom string kingwen:category = "boundary"
    custom string kingwen:action = "WAIT"
    custom string kingwen:binary = "011111"
    custom string kingwen:upper_trigram = "Xun"
    custom string kingwen:lower_trigram = "Qian"
    custom float kingwen:vortex_tension = 0.8571

    def Mesh "PointVectorCloud"
    {
        uniform token kind = "pointcloud"
        string kingwen:ply_reference = "../kingwen_avatar_meshes/hex44_phase0.ply"
        uniform token orientation = "rightHanded"
    }
}
