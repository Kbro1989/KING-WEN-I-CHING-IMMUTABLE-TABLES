#usda 1.0
(
    defaultPrim = "SovereignNPC_13"
    metersPerUnit = 1.0
    upAxis = "Y"
)

def Xform "SovereignNPC_13"
(
    kind = "component"
)
{
    double3 xformOp:translate = (4.0, 0.0, -20.0)
    uniform token[] xformOpOrder = ["xformOp:translate"]

    custom string kingwen:name = "Fellowship with Men"
    custom int kingwen:hexagram_id = 13
    custom string kingwen:category = "transformer"
    custom string kingwen:action = "ASSERT"
    custom string kingwen:binary = "101111"
    custom string kingwen:upper_trigram = "Qian"
    custom string kingwen:lower_trigram = "Li"
    custom float kingwen:vortex_tension = 0.7143

    def Mesh "PointVectorCloud"
    {
        uniform token kind = "pointcloud"
        string kingwen:ply_reference = "../kingwen_avatar_meshes/hex13_phase0.ply"
        uniform token orientation = "rightHanded"
    }
}
