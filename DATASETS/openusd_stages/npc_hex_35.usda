#usda 1.0
(
    defaultPrim = "SovereignNPC_35"
    metersPerUnit = 1.0
    upAxis = "Y"
)

def Xform "SovereignNPC_35"
(
    kind = "component"
)
{
    double3 xformOp:translate = (-12.0, 0.0, 4.0)
    uniform token[] xformOpOrder = ["xformOp:translate"]

    custom string kingwen:name = "Progress"
    custom int kingwen:hexagram_id = 35
    custom string kingwen:category = "transformer"
    custom string kingwen:action = "ADAPT"
    custom string kingwen:binary = "000101"
    custom string kingwen:upper_trigram = "Kun"
    custom string kingwen:lower_trigram = "Li"
    custom float kingwen:vortex_tension = 0.0

    def Mesh "PointVectorCloud"
    {
        uniform token kind = "pointcloud"
        string kingwen:ply_reference = "../kingwen_avatar_meshes/hex35_phase0.ply"
        uniform token orientation = "rightHanded"
    }
}
