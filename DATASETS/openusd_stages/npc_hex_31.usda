#usda 1.0
(
    defaultPrim = "SovereignNPC_31"
    metersPerUnit = 1.0
    upAxis = "Y"
)

def Xform "SovereignNPC_31"
(
    kind = "component"
)
{
    double3 xformOp:translate = (20.0, 0.0, -4.0)
    uniform token[] xformOpOrder = ["xformOp:translate"]

    custom string kingwen:name = "Influence"
    custom int kingwen:hexagram_id = 31
    custom string kingwen:category = "transformer"
    custom string kingwen:action = "YIELD"
    custom string kingwen:binary = "001110"
    custom string kingwen:upper_trigram = "Gen"
    custom string kingwen:lower_trigram = "Dui"
    custom float kingwen:vortex_tension = 0.2449

    def Mesh "PointVectorCloud"
    {
        uniform token kind = "pointcloud"
        string kingwen:ply_reference = "../kingwen_avatar_meshes/hex31_phase0.ply"
        uniform token orientation = "rightHanded"
    }
}
