#usda 1.0
(
    defaultPrim = "SovereignNPC_32"
    metersPerUnit = 1.0
    upAxis = "Y"
)

def Xform "SovereignNPC_32"
(
    kind = "component"
)
{
    custom string kingwen:category = "boundary"
    custom string kingwen:action = "WAIT"
    custom int kingwen:hexagram_id = 32
    def Mesh "PointVectorCloud"
    {
        uniform token kind = "pointcloud"
        string kingwen:ply_reference = "../kingwen_avatar_meshes/hex32_phase0.ply"
        uniform token orientation = "rightHanded"
    }
}
