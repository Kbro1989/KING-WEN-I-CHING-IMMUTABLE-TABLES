#usda 1.0
(
    defaultPrim = "SovereignNPC_32"
    metersPerUnit = 1.0
    upAxis = "Y"
)

def Xform "SovereignNPC_32"
(
    kind = "component"
)
{
    double3 xformOp:translate = (28.0, 0.0, -4.0)
    uniform token[] xformOpOrder = ["xformOp:translate"]

    custom string kingwen:name = "Duration"
    custom int kingwen:hexagram_id = 32
    custom string kingwen:category = "boundary"
    custom string kingwen:action = "WAIT"
    custom string kingwen:binary = "011100"
    custom string kingwen:upper_trigram = "Xun"
    custom string kingwen:lower_trigram = "Zhen"
    custom float kingwen:vortex_tension = 0.1224

    def Mesh "PointVectorCloud"
    {
        uniform token kind = "pointcloud"
        string kingwen:ply_reference = "../kingwen_avatar_meshes/hex32_phase0.ply"
        uniform token orientation = "rightHanded"
    }
}
