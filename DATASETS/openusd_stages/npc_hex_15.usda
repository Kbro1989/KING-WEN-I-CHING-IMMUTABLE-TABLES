#usda 1.0
(
    defaultPrim = "SovereignNPC_15"
    metersPerUnit = 1.0
    upAxis = "Y"
)

def Xform "SovereignNPC_15"
(
    kind = "component"
)
{
    double3 xformOp:translate = (20.0, 0.0, -20.0)
    uniform token[] xformOpOrder = ["xformOp:translate"]

    custom string kingwen:name = "Modesty"
    custom int kingwen:hexagram_id = 15
    custom string kingwen:category = "transformer"
    custom string kingwen:action = "YIELD"
    custom string kingwen:binary = "001000"
    custom string kingwen:upper_trigram = "Kun"
    custom string kingwen:lower_trigram = "Gen"
    custom float kingwen:vortex_tension = 0.0

    def Mesh "PointVectorCloud"
    {
        uniform token kind = "pointcloud"
        string kingwen:ply_reference = "../kingwen_avatar_meshes/hex15_phase0.ply"
        uniform token orientation = "rightHanded"
    }
}
