#usda 1.0
(
    defaultPrim = "SovereignNPC_63"
    metersPerUnit = 1.0
    upAxis = "Y"
)

def Xform "SovereignNPC_63"
(
    kind = "component"
)
{
    double3 xformOp:translate = (20.0, 0.0, 28.0)
    uniform token[] xformOpOrder = ["xformOp:translate"]

    custom string kingwen:name = "After Completion"
    custom int kingwen:hexagram_id = 63
    custom string kingwen:category = "boundary"
    custom string kingwen:action = "WAIT"
    custom string kingwen:binary = "101010"
    custom string kingwen:upper_trigram = "Li"
    custom string kingwen:lower_trigram = "Kan"
    custom float kingwen:vortex_tension = 0.2041

    def Mesh "PointVectorCloud"
    {
        uniform token kind = "pointcloud"
        string kingwen:ply_reference = "../kingwen_avatar_meshes/hex63_phase0.ply"
        uniform token orientation = "rightHanded"
    }
}
