#usda 1.0
(
    defaultPrim = "SovereignNPC_51"
    metersPerUnit = 1.0
    upAxis = "Y"
)

def Xform "SovereignNPC_51"
(
    kind = "component"
)
{
    double3 xformOp:translate = (-12.0, 0.0, 20.0)
    uniform token[] xformOpOrder = ["xformOp:translate"]

    custom string kingwen:name = "The Arousing"
    custom int kingwen:hexagram_id = 51
    custom string kingwen:category = "sovereign"
    custom string kingwen:action = "ASSERT"
    custom string kingwen:binary = "100100"
    custom string kingwen:upper_trigram = "Zhen"
    custom string kingwen:lower_trigram = "Zhen"
    custom float kingwen:vortex_tension = 0.0204

    def Mesh "PointVectorCloud"
    {
        uniform token kind = "pointcloud"
        string kingwen:ply_reference = "../kingwen_avatar_meshes/hex51_phase0.ply"
        uniform token orientation = "rightHanded"
    }
}
