#usda 1.0
(
    defaultPrim = "SovereignNPC_41"
    metersPerUnit = 1.0
    upAxis = "Y"
)

def Xform "SovereignNPC_41"
(
    kind = "component"
)
{
    double3 xformOp:translate = (-28.0, 0.0, 12.0)
    uniform token[] xformOpOrder = ["xformOp:translate"]

    custom string kingwen:name = "Decrease"
    custom int kingwen:hexagram_id = 41
    custom string kingwen:category = "transformer"
    custom string kingwen:action = "YIELD"
    custom string kingwen:binary = "100011"
    custom string kingwen:upper_trigram = "Dui"
    custom string kingwen:lower_trigram = "Gen"
    custom float kingwen:vortex_tension = 0.1224

    def Mesh "PointVectorCloud"
    {
        uniform token kind = "pointcloud"
        string kingwen:ply_reference = "../kingwen_avatar_meshes/hex41_phase0.ply"
        uniform token orientation = "rightHanded"
    }
}
