#usda 1.0
(
    defaultPrim = "SovereignNPC_64"
    metersPerUnit = 1.0
    upAxis = "Y"
)

def Xform "SovereignNPC_64"
(
    kind = "component"
)
{
    double3 xformOp:translate = (28.0, 0.0, 28.0)
    uniform token[] xformOpOrder = ["xformOp:translate"]

    custom string kingwen:name = "Before Completion"
    custom int kingwen:hexagram_id = 64
    custom string kingwen:category = "transformer"
    custom string kingwen:action = "ADAPT"
    custom string kingwen:binary = "010101"
    custom string kingwen:upper_trigram = "Kan"
    custom string kingwen:lower_trigram = "Li"
    custom float kingwen:vortex_tension = 0.2041

    def Mesh "PointVectorCloud"
    {
        uniform token kind = "pointcloud"
        string kingwen:ply_reference = "../kingwen_avatar_meshes/hex64_phase0.ply"
        uniform token orientation = "rightHanded"
    }
}
