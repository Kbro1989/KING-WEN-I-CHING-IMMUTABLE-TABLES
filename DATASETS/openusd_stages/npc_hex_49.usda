#usda 1.0
(
    defaultPrim = "SovereignNPC_49"
    metersPerUnit = 1.0
    upAxis = "Y"
)

def Xform "SovereignNPC_49"
(
    kind = "component"
)
{
    double3 xformOp:translate = (-28.0, 0.0, 20.0)
    uniform token[] xformOpOrder = ["xformOp:translate"]

    custom string kingwen:name = "Revolution"
    custom int kingwen:hexagram_id = 49
    custom string kingwen:category = "transformer"
    custom string kingwen:action = "ASSERT"
    custom string kingwen:binary = "101110"
    custom string kingwen:upper_trigram = "Li"
    custom string kingwen:lower_trigram = "Dui"
    custom float kingwen:vortex_tension = 0.3061

    def Mesh "PointVectorCloud"
    {
        uniform token kind = "pointcloud"
        string kingwen:ply_reference = "../kingwen_avatar_meshes/hex49_phase0.ply"
        uniform token orientation = "rightHanded"
    }
}
