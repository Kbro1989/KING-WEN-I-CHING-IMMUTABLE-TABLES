#usda 1.0
(
    defaultPrim = "SovereignNPC_42"
    metersPerUnit = 1.0
    upAxis = "Y"
)

def Xform "SovereignNPC_42"
(
    kind = "component"
)
{
    double3 xformOp:translate = (-20.0, 0.0, 12.0)
    uniform token[] xformOpOrder = ["xformOp:translate"]

    custom string kingwen:name = "Increase"
    custom int kingwen:hexagram_id = 42
    custom string kingwen:category = "transformer"
    custom string kingwen:action = "ASSERT"
    custom string kingwen:binary = "110001"
    custom string kingwen:upper_trigram = "Zhen"
    custom string kingwen:lower_trigram = "Xun"
    custom float kingwen:vortex_tension = 0.2449

    def Mesh "PointVectorCloud"
    {
        uniform token kind = "pointcloud"
        string kingwen:ply_reference = "../kingwen_avatar_meshes/hex42_phase0.ply"
        uniform token orientation = "rightHanded"
    }
}
