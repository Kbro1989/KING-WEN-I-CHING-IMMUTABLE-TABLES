#usda 1.0
(
    defaultPrim = "SovereignNPC_43"
    metersPerUnit = 1.0
    upAxis = "Y"
)

def Xform "SovereignNPC_43"
(
    kind = "component"
)
{
    double3 xformOp:translate = (-12.0, 0.0, 12.0)
    uniform token[] xformOpOrder = ["xformOp:translate"]

    custom string kingwen:name = "Breakthrough"
    custom int kingwen:hexagram_id = 43
    custom string kingwen:category = "sovereign"
    custom string kingwen:action = "ASSERT"
    custom string kingwen:binary = "111110"
    custom string kingwen:upper_trigram = "Qian"
    custom string kingwen:lower_trigram = "Dui"
    custom float kingwen:vortex_tension = 0.4286

    def Mesh "PointVectorCloud"
    {
        uniform token kind = "pointcloud"
        string kingwen:ply_reference = "../kingwen_avatar_meshes/hex43_phase0.ply"
        uniform token orientation = "rightHanded"
    }
}
