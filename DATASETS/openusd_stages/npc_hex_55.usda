#usda 1.0
(
    defaultPrim = "SovereignNPC_55"
    metersPerUnit = 1.0
    upAxis = "Y"
)

def Xform "SovereignNPC_55"
(
    kind = "component"
)
{
    double3 xformOp:translate = (20.0, 0.0, 20.0)
    uniform token[] xformOpOrder = ["xformOp:translate"]

    custom string kingwen:name = "Abundance"
    custom int kingwen:hexagram_id = 55
    custom string kingwen:category = "sovereign"
    custom string kingwen:action = "ASSERT"
    custom string kingwen:binary = "001101"
    custom string kingwen:upper_trigram = "Li"
    custom string kingwen:lower_trigram = "Zhen"
    custom float kingwen:vortex_tension = 0.4082

    def Mesh "PointVectorCloud"
    {
        uniform token kind = "pointcloud"
        string kingwen:ply_reference = "../kingwen_avatar_meshes/hex55_phase0.ply"
        uniform token orientation = "rightHanded"
    }
}
