#usda 1.0
(
    defaultPrim = "SovereignNPC_07"
    metersPerUnit = 1.0
    upAxis = "Y"
)

def Xform "SovereignNPC_07"
(
    kind = "component"
)
{
    double3 xformOp:translate = (20.0, 0.0, -28.0)
    uniform token[] xformOpOrder = ["xformOp:translate"]

    custom string kingwen:name = "The Army"
    custom int kingwen:hexagram_id = 7
    custom string kingwen:category = "sovereign"
    custom string kingwen:action = "ASSERT"
    custom string kingwen:binary = "000010"
    custom string kingwen:upper_trigram = "Kan"
    custom string kingwen:lower_trigram = "Kun"
    custom float kingwen:vortex_tension = 0.0

    def Mesh "PointVectorCloud"
    {
        uniform token kind = "pointcloud"
        string kingwen:ply_reference = "../kingwen_avatar_meshes/hex07_phase0.ply"
        uniform token orientation = "rightHanded"
    }
}
