#usda 1.0
(
    defaultPrim = "SovereignNPC_54"
    metersPerUnit = 1.0
    upAxis = "Y"
)

def Xform "SovereignNPC_54"
(
    kind = "component"
)
{
    double3 xformOp:translate = (12.0, 0.0, 20.0)
    uniform token[] xformOpOrder = ["xformOp:translate"]

    custom string kingwen:name = "The Marrying Maiden"
    custom int kingwen:hexagram_id = 54
    custom string kingwen:category = "dissipator"
    custom string kingwen:action = "YIELD"
    custom string kingwen:binary = "110100"
    custom string kingwen:upper_trigram = "Dui"
    custom string kingwen:lower_trigram = "Zhen"
    custom float kingwen:vortex_tension = 0.0612

    def Mesh "PointVectorCloud"
    {
        uniform token kind = "pointcloud"
        string kingwen:ply_reference = "../kingwen_avatar_meshes/hex54_phase0.ply"
        uniform token orientation = "rightHanded"
    }
}
