#usda 1.0
(
    defaultPrim = "SovereignNPC_16"
    metersPerUnit = 1.0
    upAxis = "Y"
)

def Xform "SovereignNPC_16"
(
    kind = "component"
)
{
    double3 xformOp:translate = (28.0, 0.0, -20.0)
    uniform token[] xformOpOrder = ["xformOp:translate"]

    custom string kingwen:name = "Enthusiasm"
    custom int kingwen:hexagram_id = 16
    custom string kingwen:category = "dissipator"
    custom string kingwen:action = "ADAPT"
    custom string kingwen:binary = "000100"
    custom string kingwen:upper_trigram = "Zhen"
    custom string kingwen:lower_trigram = "Kun"
    custom float kingwen:vortex_tension = 0.0

    def Mesh "PointVectorCloud"
    {
        uniform token kind = "pointcloud"
        string kingwen:ply_reference = "../kingwen_avatar_meshes/hex16_phase0.ply"
        uniform token orientation = "rightHanded"
    }
}
