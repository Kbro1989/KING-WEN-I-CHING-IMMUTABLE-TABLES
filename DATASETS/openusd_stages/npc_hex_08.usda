#usda 1.0
(
    defaultPrim = "SovereignNPC_08"
    metersPerUnit = 1.0
    upAxis = "Y"
)

def Xform "SovereignNPC_08"
(
    kind = "component"
)
{
    double3 xformOp:translate = (28.0, 0.0, -28.0)
    uniform token[] xformOpOrder = ["xformOp:translate"]

    custom string kingwen:name = "Holding Together"
    custom int kingwen:hexagram_id = 8
    custom string kingwen:category = "transformer"
    custom string kingwen:action = "YIELD"
    custom string kingwen:binary = "010000"
    custom string kingwen:upper_trigram = "Kun"
    custom string kingwen:lower_trigram = "Kan"
    custom float kingwen:vortex_tension = 0.0

    def Mesh "PointVectorCloud"
    {
        uniform token kind = "pointcloud"
        string kingwen:ply_reference = "../kingwen_avatar_meshes/hex08_phase0.ply"
        uniform token orientation = "rightHanded"
    }
}
