#usda 1.0
(
    defaultPrim = "SovereignNPC_22"
    metersPerUnit = 1.0
    upAxis = "Y"
)

def Xform "SovereignNPC_22"
(
    kind = "component"
)
{
    double3 xformOp:translate = (12.0, 0.0, -12.0)
    uniform token[] xformOpOrder = ["xformOp:translate"]

    custom string kingwen:name = "Grace"
    custom int kingwen:hexagram_id = 22
    custom string kingwen:category = "boundary"
    custom string kingwen:action = "WAIT"
    custom string kingwen:binary = "101001"
    custom string kingwen:upper_trigram = "Li"
    custom string kingwen:lower_trigram = "Gen"
    custom float kingwen:vortex_tension = 0.4082

    def Mesh "PointVectorCloud"
    {
        uniform token kind = "pointcloud"
        string kingwen:ply_reference = "../kingwen_avatar_meshes/hex22_phase0.ply"
        uniform token orientation = "rightHanded"
    }
}
