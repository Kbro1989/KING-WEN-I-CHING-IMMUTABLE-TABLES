#usda 1.0
(
    defaultPrim = "SovereignNPC_58"
    metersPerUnit = 1.0
    upAxis = "Y"
)

def Xform "SovereignNPC_58"
(
    kind = "component"
)
{
    double3 xformOp:translate = (-20.0, 0.0, 28.0)
    uniform token[] xformOpOrder = ["xformOp:translate"]

    custom string kingwen:name = "The Joyous"
    custom int kingwen:hexagram_id = 58
    custom string kingwen:category = "transformer"
    custom string kingwen:action = "YIELD"
    custom string kingwen:binary = "110110"
    custom string kingwen:upper_trigram = "Dui"
    custom string kingwen:lower_trigram = "Dui"
    custom float kingwen:vortex_tension = 0.1837

    def Mesh "PointVectorCloud"
    {
        uniform token kind = "pointcloud"
        string kingwen:ply_reference = "../kingwen_avatar_meshes/hex58_phase0.ply"
        uniform token orientation = "rightHanded"
    }
}
