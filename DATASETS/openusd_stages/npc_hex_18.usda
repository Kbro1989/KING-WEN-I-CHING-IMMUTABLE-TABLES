#usda 1.0
(
    defaultPrim = "SovereignNPC_18"
    metersPerUnit = 1.0
    upAxis = "Y"
)

def Xform "SovereignNPC_18"
(
    kind = "component"
)
{
    double3 xformOp:translate = (-20.0, 0.0, -12.0)
    uniform token[] xformOpOrder = ["xformOp:translate"]

    custom string kingwen:name = "Work on Decayed"
    custom int kingwen:hexagram_id = 18
    custom string kingwen:category = "dissipator"
    custom string kingwen:action = "ADAPT"
    custom string kingwen:binary = "011001"
    custom string kingwen:upper_trigram = "Xun"
    custom string kingwen:lower_trigram = "Gen"
    custom float kingwen:vortex_tension = 0.4898

    def Mesh "PointVectorCloud"
    {
        uniform token kind = "pointcloud"
        string kingwen:ply_reference = "../kingwen_avatar_meshes/hex18_phase0.ply"
        uniform token orientation = "rightHanded"
    }
}
