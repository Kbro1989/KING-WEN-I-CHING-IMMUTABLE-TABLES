#usda 1.0
(
    defaultPrim = "SovereignNPC_14"
    metersPerUnit = 1.0
    upAxis = "Y"
)

def Xform "SovereignNPC_14"
(
    kind = "component"
)
{
    double3 xformOp:translate = (12.0, 0.0, -20.0)
    uniform token[] xformOpOrder = ["xformOp:translate"]

    custom string kingwen:name = "Possession in Great Measure"
    custom int kingwen:hexagram_id = 14
    custom string kingwen:category = "sovereign"
    custom string kingwen:action = "ASSERT"
    custom string kingwen:binary = "111101"
    custom string kingwen:upper_trigram = "Li"
    custom string kingwen:lower_trigram = "Qian"
    custom float kingwen:vortex_tension = 0.7143

    def Mesh "PointVectorCloud"
    {
        uniform token kind = "pointcloud"
        string kingwen:ply_reference = "../kingwen_avatar_meshes/hex14_phase0.ply"
        uniform token orientation = "rightHanded"
    }
}
