#usda 1.0
(
    defaultPrim = "SovereignNPC_38"
    metersPerUnit = 1.0
    upAxis = "Y"
)

def Xform "SovereignNPC_38"
(
    kind = "component"
)
{
    double3 xformOp:translate = (12.0, 0.0, 4.0)
    uniform token[] xformOpOrder = ["xformOp:translate"]

    custom string kingwen:name = "Opposition"
    custom int kingwen:hexagram_id = 38
    custom string kingwen:category = "dissipator"
    custom string kingwen:action = "ADAPT"
    custom string kingwen:binary = "110101"
    custom string kingwen:upper_trigram = "Dui"
    custom string kingwen:lower_trigram = "Li"
    custom float kingwen:vortex_tension = 0.3061

    def Mesh "PointVectorCloud"
    {
        uniform token kind = "pointcloud"
        string kingwen:ply_reference = "../kingwen_avatar_meshes/hex38_phase0.ply"
        uniform token orientation = "rightHanded"
    }
}
