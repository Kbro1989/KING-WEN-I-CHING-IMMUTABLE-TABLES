#usda 1.0
(
    defaultPrim = "SovereignNPC_17"
    metersPerUnit = 1.0
    upAxis = "Y"
)

def Xform "SovereignNPC_17"
(
    kind = "component"
)
{
    double3 xformOp:translate = (-28.0, 0.0, -12.0)
    uniform token[] xformOpOrder = ["xformOp:translate"]

    custom string kingwen:name = "Following"
    custom int kingwen:hexagram_id = 17
    custom string kingwen:category = "transformer"
    custom string kingwen:action = "YIELD"
    custom string kingwen:binary = "100110"
    custom string kingwen:upper_trigram = "Zhen"
    custom string kingwen:lower_trigram = "Dui"
    custom float kingwen:vortex_tension = 0.0612

    def Mesh "PointVectorCloud"
    {
        uniform token kind = "pointcloud"
        string kingwen:ply_reference = "../kingwen_avatar_meshes/hex17_phase0.ply"
        uniform token orientation = "rightHanded"
    }
}
