#usda 1.0
(
    defaultPrim = "SovereignNPC_45"
    metersPerUnit = 1.0
    upAxis = "Y"
)

def Xform "SovereignNPC_45"
(
    kind = "component"
)
{
    custom string kingwen:category = "transformer"
    custom string kingwen:action = "YIELD"
    custom int kingwen:hexagram_id = 45
    def Mesh "PointVectorCloud"
    {
        uniform token kind = "pointcloud"
        string kingwen:ply_reference = "../kingwen_avatar_meshes/hex45_phase0.ply"
        uniform token orientation = "rightHanded"
    }
}
