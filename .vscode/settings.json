{
    "chat.utilityModel": "ollama/qwen2.5-coder:7b-instruct-q4_K_M",
    "chat.utilitySmallModel": "ollama/qwen3.6:27b",
    "python-envs.pythonProjects": [
        {
            "path": "kingwen_ternary_tables_complete.py",
            "envManager": "ms-python.python:venv",
            "packageManager": "ms-python.python:pip"
        }
    ],
    "python-envs.defaultEnvManager": "ms-python.python:system",
    "search.exclude": {
        "**/.git": true,
        "**/__pycache__": true,
        "**/.pytest_cache": true,
        "**/.mypy_cache": true,
        "**/node_modules": true,
        "**/dist": true,
        "**/.wrangler": true,
        "**/.venv": true,
        "**/.snapshot_prior": true,
        "**/.staging": true
    },
    "files.exclude": {
        "**/__pycache__": true,
        "**/*.pyc": true,
        "**/.pytest_cache": true,
        "**/.mypy_cache": true,
        "**/.wrangler": true
    },
    "files.watcherExclude": {
        "**/.git/objects/**": true,
        "**/__pycache__/**": true,
        "**/node_modules/**": true,
        "**/dist/**": true,
        "**/.wrangler/**": true,
        "**/*.pyc": true
    },
    "search.followSymlinks": false,
    "search.useIgnoreFiles": true,
    "files.associations": {
        "*.vhd": "vhdl",
        "*.jsonc": "jsonc",
        "*.jsonl": "jsonl",
        "*.md": "markdown",
        "*.py": "python",
        "*.ts": "typescript",
        "*.tsx": "typescriptreact",
        "*.js": "javascript",
        "*.html": "html",
        "*.css": "css",
        "*.csv": "csv",
        "*.toml": "toml",
        "*.yaml": "yaml",
        "*.yml": "yaml"
    },
    "editor.formatOnSave": false,
    "python.analysis.extraPaths": [
        "scripts",
        "kingwen_train_data",
        "learn/scripts"
    ],
    "typescript.tsdk": "node_modules/typescript/lib",
    "typescript.preferences.importModuleSpecifier": "relative",
    "git.detectSubmodules": false
}
